{
  "manifest_version": 3,
  "name": "MyCase Tools",
  "version": "1.1",
  "description": "Adds dark mode and various tools to MyCase.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://public.courts.in.gov/mycase/*",
    "https://public.courts.in.gov/AttorneyDashboard/*",
    "https://public.courts.in.gov/Portal/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://public.courts.in.gov/mycase/*",
        "https://public.courts.in.gov/AttorneyDashboard/*",
        "https://public.courts.in.gov/Portal/*"
      ],
      "js": ["content.js"],
      "css": ["dark-mode.css", "tools.css"]
    },
    {
      "matches": ["https://public.courts.in.gov/mycase/*"],
      "js": ["recent-search-api.js", "recent-search.js"],
      "run_at": "document_idle"
    }
  ],
   "icons": {
       "128": "icon.png"
     }
}
